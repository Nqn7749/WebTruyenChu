From 242dd154996b105dd9f52392d98b6fedb382ea57 Mon Sep 17 00:00:00 2001
From: Nqn7749 <184545265+Nqn7749@users.noreply.github.com>
Date: Sat, 21 Nov 2026 09:39:03 +0000
Subject: [PATCH] fix: bo trustProxies('*') truoc khi deploy + ghi chu APP_URL

Site chua deploy, chua biet production co load balancer/proxy hay
khong. trustProxies('*') tin X-Forwarded-For tu bat cu ai nen ai
cung gia duoc IP, qua mat throttle login/tim-kiem va thoi view
(NL-9). Bo ve mac dinh an toan; khi deploy, neu sau proxy thi them
lai voi dung IP cua proxy, neu chay truc tiep thi de nguyen.
Them ghi chu o .env.example: APP_URL production phai doi thanh
domain that qua HTTPS (NL-10).
---
 .env.example      |  4 ++++
 bootstrap/app.php | 14 ++++++++++----
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/.env.example b/.env.example
index 30766ee..2dea4b3 100644
--- a/.env.example
+++ b/.env.example
@@ -4,6 +4,10 @@ APP_KEY=
 # Chỉ bật true khi debug trên máy local; production luôn để false
 # (true sẽ lộ stack trace, câu SQL và đường dẫn file khi lỗi).
 APP_DEBUG=false
+# APP_URL ở đây chỉ là mặc định cho máy local. Khi deploy production,
+# file .env trên server PHẢI đổi thành domain thật qua HTTPS,
+# vd APP_URL=https://ten-mien-that-cua-ban — nếu để localhost thì email xác
+# minh, link reset mật khẩu, sitemap và canonical đều sai host (NL-10).
 APP_URL=http://localhost
 
 APP_LOCALE=vi
diff --git a/bootstrap/app.php b/bootstrap/app.php
index 27b9f4a..4b6ee84 100644
--- a/bootstrap/app.php
+++ b/bootstrap/app.php
@@ -25,10 +25,16 @@
         },
     )
     ->withMiddleware(function (Middleware $middleware): void {
-        // App chạy sau load balancer (xem docs/production-readiness.md):
-        // tin X-Forwarded-For để request()->ip() ra IP thật của visitor
-        // (đếm view và throttle login đều dựa vào IP).
-        $middleware->trustProxies(at: '*');
+        // KHÔNG tin proxy nào theo mặc định: site chưa deploy, chưa biết
+        // production có load balancer/proxy hay không. trustProxies('*')
+        // tin X-Forwarded-For từ bất cứ ai nên ai cũng giả được IP, qua
+        // mặt throttle login/tìm kiếm và thổi view (NL-9). Khi deploy,
+        // nếu sau load balancer/proxy thì thêm lại với đúng IP của nó,
+        // vd trustProxies(at: ['123.45.67.89']); nếu chạy trực tiếp
+        // (Nginx -> PHP-FPM, không proxy) thì để nguyên như này.
+        // Lưu ý: nếu deploy sau proxy mà quên thêm lại, request()->ip()
+        // sẽ ra IP của proxy cho mọi user nên throttle login/view đếm
+        // chung — test đăng nhập sẽ thấy 429 ngay, kiểm tra lúc deploy.
 
         //
         $middleware->alias([
