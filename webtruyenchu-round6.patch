+    expect(Story::query()->where('title', 'Truyện tác giả lạ')->exists())->toBeFalse();
+});
diff --git a/tests/Feature/Round6JobsMiscTest.php b/tests/Feature/Round6JobsMiscTest.php
new file mode 100644
