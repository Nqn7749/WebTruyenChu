diff --git a/tests/Feature/Round6AuthTest.php b/tests/Feature/Round6AuthTest.php
new file mode 100644
index 0000000..41b55ea
--- /dev/null
+++ b/tests/Feature/Round6AuthTest.php
@@ -0,0 +1,171 @@
+<?php
+
+use App\Models\Role;
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+
+test('changing password logs out other sessions but keeps the current one', function () {
+    config(['session.driver' => 'database']);
+
+    $user = User::factory()->create();
+
+    // Thiết bị A đăng nhập trong test client.
+    $this->post('/login', [
+        'email' => $user->email,
+        'password' => 'Password1234',
+    ])->assertRedirect(route('home', absolute: false));
+    $deviceAId = session()->getId();
+
+    // Thiết bị B: bắt đầu từ một session id hoàn toàn mới rồi đăng nhập
+    // bằng cùng tài khoản. withCookie nhận session id thô, framework
+    // sẽ tự mã hóa cookie khi gửi request.
+    $this->withCookie(config('session.cookie'), (string) Str::uuid())
+        ->post('/login', [
+            'email' => $user->email,
+            'password' => 'Password1234',
+        ])->assertRedirect(route('home', absolute: false));
+    $deviceBId = session()->getId();
+
+    expect($deviceBId)->not->toBe($deviceAId);
+
+    // Thiết bị A đổi mật khẩu.
+    $this->withCookie(config('session.cookie'), $deviceAId)
+        ->put('/password', [
+            'current_password' => 'Password1234',
+            'password' => 'NewPassword1234',
+            'password_confirmation' => 'NewPassword1234',
+        ])->assertSessionHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+
+    // Thiết bị A vẫn dùng được.
+    $this->withCookie(config('session.cookie'), $deviceAId)
+        ->get('/profile')->assertOk();
+
+    // Thiết bị B bị đăng xuất: hash mật khẩu trong session cũ không
+    // còn khớp sau khi đổi mật khẩu (AuthenticateSession).
+    $this->withCookie(config('session.cookie'), $deviceBId)
+        ->get('/profile')->assertRedirect(route('login'));
+});
+
+test('resetting password deletes all user sessions', function () {
+    config(['session.driver' => 'database']);
+
+    $user = User::factory()->create();
+
+    // Giả lập 2 thiết bị đang đăng nhập của user.
+    $sessionIds = [(string) Str::uuid(), (string) Str::uuid()];
+
+    foreach ($sessionIds as $id) {
+        DB::table('sessions')->insert([
+            'id' => $id,
+            'user_id' => $user->id,
+            'ip_address' => '127.0.0.1',
+            'user_agent' => 'test',
+            'payload' => base64_encode(serialize(['login_web' => $user->id])),
+            'last_activity' => now()->timestamp,
+        ]);
+    }
+
+    Notification::fake();
+
+    $this->post('/forgot-password', ['email' => $user->email]);
+
+    Notification::assertSentTo($user, ResetPassword::class, function ($notification) use ($user) {
+        $response = $this->post('/reset-password', [
+            'token' => $notification->token,
+            'email' => $user->email,
+            'password' => 'NewPassword1234',
+            'password_confirmation' => 'NewPassword1234',
+        ]);
+
+        $response->assertSessionHasNoErrors()->assertRedirect(route('login'));
+
+        expect(DB::table('sessions')->where('user_id', $user->id)->count())->toBe(0);
+
+        return true;
+    });
+});
+
+test('global per-account login bucket locks out after twenty failures regardless of IP', function () {
+    $user = User::factory()->create(['username' => 'global-bucket']);
+    $key = 'login-user:'.$user->id;
+
+    RateLimiter::clear($key);
+
+    try {
+        // Trong test mọi request đều từ 127.0.0.1 nên bucket theo IP
+        // sẽ khóa trước; vì vậy hit trực tiếp bucket toàn cục để
+        // chứng minh nó hoạt động độc lập với IP.
+        foreach (range(1, 20) as $i) {
+            RateLimiter::hit($key, 3600);
+        }
+
