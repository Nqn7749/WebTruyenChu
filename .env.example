APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Chỉ bật true khi debug trên máy local; production luôn để false
# (true sẽ lộ stack trace, câu SQL và đường dẫn file khi lỗi).
APP_DEBUG=false
# APP_URL ở đây chỉ là mặc định cho máy local. Khi deploy production,
# file .env trên server PHẢI đổi thành domain thật qua HTTPS,
# vd APP_URL=https://ten-mien-that-cua-ban — nếu để localhost thì email xác
# minh, link reset mật khẩu, sitemap và canonical đều sai host (NL-10).
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webtruyenchu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Mã hóa payload session bằng APP_KEY: session lưu trong DB dạng plaintext
# thì ai đọc được DB sẽ đọc được nội dung session (NL-10). Nhớ set
# SESSION_ENCRYPT=true cả ở file .env production, đổi .env.example
# không tự đổi .env đã deploy.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Chỉ bật khi chạy production qua HTTPS (xem docs/production-readiness.md).
# Khi chạy http trên máy local thì để trống/false, nếu không cookie sẽ
# không được trình duyệt gửi đi và không đăng nhập được.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Story URL import: restrict imports to hosts listed in config/story_import.php
STORY_IMPORT_REQUIRE_ALLOWLIST=false
